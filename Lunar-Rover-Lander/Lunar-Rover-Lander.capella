        <ownedRequirements xsi:type="Requirements:Folder" id="e8c6affb-fbfc-4365-b1f6-c73a671039cf"
            ReqIFLongName="[REQ] Stakeholder">
          <ownedRequirements xsi:type="Requirements:Requirement" id="79ee3812-36b5-412b-a9d2-9fe518a23417"
              ReqIFLongName="" ReqIFName="MIS-001" ReqIFPrefix="" ReqIFChapterName=""
              ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Delivery System shall transport the customer-provided rover from the 100 km stable circular lunar orbit to the lunar surface.&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="ae158c9f-4bae-4013-9d65-5f92793a42d7" source="#79ee3812-36b5-412b-a9d2-9fe518a23417"
                target="#60ad812d-eada-442e-aa65-c7e3b0bf6f2f"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="faae00c3-6340-4d5c-8286-a055133b25f9"
              ReqIFLongName="" ReqIFName="MIS-002" ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Delivery System shall protect the rover throughout descent, landing, and deployment.&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="0fe755bf-f952-47bf-8402-bcc07377f87a" source="#faae00c3-6340-4d5c-8286-a055133b25f9"
                target="#1db61a0f-ef6c-4bb7-a97a-3a56c7a1d82d"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="39295ed1-fcec-4986-a901-9c717cef4a49" source="#faae00c3-6340-4d5c-8286-a055133b25f9"
                target="#8b54f059-0f05-4aaf-8f53-d7195cf5a384"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="4f3614ce-baa1-4421-9348-619aca4c3329" source="#faae00c3-6340-4d5c-8286-a055133b25f9"
                target="#60ad812d-eada-442e-aa65-c7e3b0bf6f2f"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="812c9218-24a8-4917-8842-7e13fa18a26f"
              ReqIFLongName="" ReqIFName="MIS-003" ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Delivery System shall deploy the rover onto the lunar surface in its nominal operational configuration.&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="e92cdc0b-2591-4222-a881-a167bb1bf538" source="#812c9218-24a8-4917-8842-7e13fa18a26f"
                target="#8b54f059-0f05-4aaf-8f53-d7195cf5a384"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="0a1008eb-74ea-4bb2-baf0-46109ee5c76a"
              ReqIFLongName="" ReqIFName="MIS-004" ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Lander shall act as an relay between the rover and ground station&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="2012088c-e2bb-4b8c-97ad-62fec07d2efd" source="#0a1008eb-74ea-4bb2-baf0-46109ee5c76a"
                target="#1db61a0f-ef6c-4bb7-a97a-3a56c7a1d82d"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="2d4896c4-698c-473e-8e22-d76e6b164493"
              ReqIFLongName="" ReqIFName="MIS-005" ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Lander shall supply 10w of power to the rover during transport&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="cefa6c98-a601-4cbb-b8ba-6a10ad16c99d" source="#2d4896c4-698c-473e-8e22-d76e6b164493"
                target="#1db61a0f-ef6c-4bb7-a97a-3a56c7a1d82d"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="2088acd4-e09d-4c4d-bad2-37aa8b08f71b"
              ReqIFLongName="" ReqIFName="MIS-006" ReqIFPrefix="" ReqIFChapterName=""
              ReqIFText="&lt;p>&lt;span style=&quot;font-family:&amp;quot;Aptos Narrow&amp;quot;,Calibri,&amp;quot;sans-serif&amp;quot;,&amp;quot;Mongolian Baiti&amp;quot;,&amp;quot;Microsoft Yi Baiti&amp;quot;,&amp;quot;Javanese Text&amp;quot;,&amp;quot;Yu Gothic&amp;quot;; font-size:14.66px&quot;>The Lunar Delivery System shall support initial rover health verification after deployment.&lt;/span>&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="6465c063-1535-4ac8-8178-4e685aa7eb89" source="#2088acd4-e09d-4c4d-bad2-37aa8b08f71b"
                target="#b4a09ec0-ca21-4045-bb0b-e4f5e8ad814a"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="b45667d8-5bdf-4858-9d42-15c6dcc8b849"
              ReqIFName="MIS-007" ReqIFText="&lt;p>The Lunar Delivery System shall accommodate a rover mass of 15 kg.&lt;/p>&#xA;"/>
          <ownedRequirements xsi:type="Requirements:Requirement" id="0643f725-a5be-4025-8573-65fc96c086d9"
              ReqIFName="MIS-008" ReqIFText="&lt;p>The Lunar Delivery System shall accommodate a rover with maximum folded size of 0.50 &amp;times; 0.20 &amp;times; 0.20 m.&lt;/p>&#xA;"/>
          <ownedRequirements xsi:type="Requirements:Requirement" id="fcc1b413-1960-4e3c-bc21-cb9a48a9ad63"
              ReqIFName="MIS-009" ReqIFText="&lt;p>The Lunar Delivery System shall provide sufficient clearance for deployment of a rover with maximum deployed dimensions of 0.90 &amp;times; 0.70 &amp;times; 0.45 m.&lt;/p>&#xA;"/>
        </ownedRequirements>
      </ownedExtensions>
