          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="f0eb4ed9-aa05-42a1-a159-bd52550dcec5"
              ReqIFName="PWR-003" ReqIFText="&lt;div>&lt;!--StartFragment-->&lt;!--EndFragment-->The Lunar Lander shall survive a continuous lunar-night duration of 328 hours without external electrical power.&lt;/div>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="e4229234-621f-4a63-bc6f-19b7c8384924" source="#f0eb4ed9-aa05-42a1-a159-bd52550dcec5"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="06d9622f-e1fd-461d-adee-68bc5d32504b" source="#f0eb4ed9-aa05-42a1-a159-bd52550dcec5"
                target="#fae6188f-0b9b-4d73-bc28-dedd77163c37"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="af28e50b-18c7-4902-b0f7-2f976b366ca3"
              ReqIFName="PWR-004" ReqIFText="&lt;p>The Lunar Lander shall maintain the battery and survival-critical equipment within their allowable voltage and temperature limits throughout deep hibernation.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="5bf92300-642d-4c6c-9a42-e297cdd0b3ec" source="#af28e50b-18c7-4902-b0f7-2f976b366ca3"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="ad6f8e52-7daa-4406-8ed7-cce6217c5a03" source="#af28e50b-18c7-4902-b0f7-2f976b366ca3"
                target="#b1f7d004-52f4-461b-bfd7-7ac255e80669"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="a7951aef-c35a-42c1-97c2-ae3956265faf"
              ReqIFName="PWR-005" ReqIFText="&lt;p>The Lunar Lander shall recharge its battery during lunar daylight to the energy level required for the subsequent lunar night.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="ddbb3131-5b56-466a-a828-b83c3b9bff02" source="#a7951aef-c35a-42c1-97c2-ae3956265faf"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="1cffdcbd-6171-4a74-8052-6b0e5908d4dd" source="#a7951aef-c35a-42c1-97c2-ae3956265faf"
                target="#150f3943-e135-4083-945d-dc8b8fa1721b"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="ea9cd65e-0846-4fad-8af4-e16d4488456e" source="#a7951aef-c35a-42c1-97c2-ae3956265faf"
                target="#fae6188f-0b9b-4d73-bc28-dedd77163c37"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="36945565-a727-43a4-8f56-a3c7c97244ab" source="#a7951aef-c35a-42c1-97c2-ae3956265faf"
                target="#5f49e567-91f0-4d26-a2aa-6d5cd76ac75c"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="384d0243-fb25-4580-8997-500e76886f75"
              ReqIFName="PWR-006" ReqIFText="&lt;p>The Lunar Lander shall measure battery voltage, current, temperature, and state of charge during nominal operation and before hibernation entry.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="4106fb6d-3733-41cb-8271-8c7a315deb31" source="#384d0243-fb25-4580-8997-500e76886f75"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="1b804a34-4a7f-475c-9319-55ab5f6d02a8" source="#384d0243-fb25-4580-8997-500e76886f75"
                target="#b1f7d004-52f4-461b-bfd7-7ac255e80669"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="497cc8f7-b1c2-481d-a370-0ca59f418215"
              ReqIFName="PWR-007" ReqIFText="&lt;p>The total electrical load of the Lunar Lander during deep hibernation shall not exceed 10 W average over the 328 h lunar-night design case.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="720d062d-79f9-4fe7-be49-08f80755d4d6" source="#497cc8f7-b1c2-481d-a370-0ca59f418215"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="496238a4-f4d0-479d-a5b9-837a131e0c7c" source="#497cc8f7-b1c2-481d-a370-0ca59f418215"
                target="#ea6140cf-5118-4307-b9be-d725c3c15d2f"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="081d5523-0a67-4526-9ec0-206160a87b58"
              ReqIFName="PWR-008" ReqIFText="&lt;p>The electrical power system shall be capable of supplying at least 500W.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="a14932af-5c3e-4c32-8189-f990ddcbbf17" source="#081d5523-0a67-4526-9ec0-206160a87b58"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="8afe549b-376a-4f4f-a6bf-391f14d13982" source="#081d5523-0a67-4526-9ec0-206160a87b58"
                target="#b3168432-63e8-48a7-ab9a-0b7667832c07"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="57f1f864-219b-4f7e-bd1d-8c90bfb4e21d"
              ReqIFName="PWR-009" ReqIFText="&lt;p>The electrical power system shall have a battery capacity of at least 6kWh.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="01b65ac7-b5d9-49ac-91f9-3634600b699d" source="#57f1f864-219b-4f7e-bd1d-8c90bfb4e21d"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="3216d6fb-8cd0-48df-9a1f-6e90766896f5" source="#57f1f864-219b-4f7e-bd1d-8c90bfb4e21d"
                target="#fae6188f-0b9b-4d73-bc28-dedd77163c37"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="3d7664f0-6f6a-4b7a-8f43-07b4e888144f"
              ReqIFName="PWR-010" ReqIFText="&lt;p>the electircal power system shall have a solar peak output of greater than 350W.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="c2f11b49-4865-4570-aa05-ec1b5b5dd772" source="#3d7664f0-6f6a-4b7a-8f43-07b4e888144f"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="79ea8fba-263d-4651-a842-7b9ac7b6cc0f" source="#3d7664f0-6f6a-4b7a-8f43-07b4e888144f"
                target="#5f49e567-91f0-4d26-a2aa-6d5cd76ac75c"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="36030116-3b98-462a-bf6b-02c56c021093" source="#3d7664f0-6f6a-4b7a-8f43-07b4e888144f"
                target="#150f3943-e135-4083-945d-dc8b8fa1721b"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="14c4dd85-42f1-4a67-8c8a-d40954a7919c"
              ReqIFName="PWR-011" ReqIFText="&lt;p>The electircal power system shall be capable of supplying 60watts average during day time operations.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="86e05668-a953-4d01-90a1-f20c6e1810f5" source="#14c4dd85-42f1-4a67-8c8a-d40954a7919c"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="af25332e-1833-4fca-8237-346986d6ff08" source="#14c4dd85-42f1-4a67-8c8a-d40954a7919c"
                target="#ea6140cf-5118-4307-b9be-d725c3c15d2f"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="eac20f94-7869-4b8c-ac81-dd942cc0ec2b"
              ReqIFName="PWR-012" ReqIFText="&lt;p>The Lunar Lander solar-power system shall generate sufficient electrical energy during the 328 hour lunar-day design period to support illuminated-surface operation and restore the battery energy required for the subsequent 328 hour lunar night.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="4d26d8a1-b11d-4249-b753-30076f61b8c1" source="#eac20f94-7869-4b8c-ac81-dd942cc0ec2b"
                target="#80430579-6e39-4ace-826b-c0b21c251957"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="91df5c09-4da4-48c4-9525-4c0d4b969ae8" source="#eac20f94-7869-4b8c-ac81-dd942cc0ec2b"
                target="#b5a67728-7193-4aa9-bfe5-faf765c02fd8"/>
          </ownedRequirements>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Folder" id="d310ff74-9d65-4823-bdd2-e8645596307b"
            ReqIFName="[REQ] Thermal">
          <ownedRequirements xsi:type="Requirements:Requirement" id="a9aa27e4-5907-4f43-acf5-34db60385e1e"
              ReqIFName="THM-001" ReqIFText="&lt;p>The Lunar Lander shall maintain survival-critical equipment within its allowable temperature limits during the surface mission.&lt;/p>&#xA;"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Folder" id="810605bd-89c4-43b0-9af3-5da28ab48d11"
            ReqIFName="[REQ] Lander">
          <ownedRequirements xsi:type="Requirements:Requirement" id="a0a772fc-726f-46e2-807e-c1c87e270920"
              ReqIFName="LND-001" ReqIFText="&lt;p>The Lunar Lander shall have a vertical velocity relative to the local terrain of no greater than 2.0 m/s at initial landing-gear contact.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="a62c59b0-b854-445b-8869-045e5ee2c7e7" source="#a0a772fc-726f-46e2-807e-c1c87e270920"
                target="#e87ea873-2737-49ad-8534-fe3b452ba595"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="5b75cb5b-35ea-459a-94a6-08c64b4d6276" source="#a0a772fc-726f-46e2-807e-c1c87e270920"
                target="#dd8718b7-692b-4b77-965f-73ef9fe8e693"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="8f26a91b-c7b4-4bb6-bb88-738c4e2351fa"
              ReqIFName="LND-002" ReqIFText="&lt;p>&amp;nbsp;&amp;nbsp;The Lunar Lander shall have a horizontal velocity relative to the local terrain of no greater than 1.0 m/s at initial landing-gear contact.&lt;!--EndFragment-->&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="63c4e212-322e-4130-83bd-7c460dbeeea0" source="#8f26a91b-c7b4-4bb6-bb88-738c4e2351fa"
                target="#e87ea873-2737-49ad-8534-fe3b452ba595"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="7d63e1e7-6467-47b8-a41f-ab6c541ab257" source="#8f26a91b-c7b4-4bb6-bb88-738c4e2351fa"
                target="#dd8718b7-692b-4b77-965f-73ef9fe8e693"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="a5e5bbfa-46bb-4a74-8b41-4916c666c865"
              ReqIFName="LND-003" ReqIFText="&lt;p>The Lunar lander shall land with a max angle of 24 degrees tangental to the surface&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="af10d400-1303-4457-a742-6c124043571b" source="#a5e5bbfa-46bb-4a74-8b41-4916c666c865"
                target="#e87ea873-2737-49ad-8534-fe3b452ba595"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="94f6b9b4-f489-4185-a407-8f4a1d4301f8" source="#a5e5bbfa-46bb-4a74-8b41-4916c666c865"
                target="#dd8718b7-692b-4b77-965f-73ef9fe8e693"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="4955cdc6-2b24-4f67-a860-ad2124205135"
              ReqIFName="LND-004" ReqIFText="&lt;p>The Lunar lander landing legs shall be deployed before powered descent.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="8e0f3ab4-f075-4812-91ef-56889b6ac069" source="#4955cdc6-2b24-4f67-a860-ad2124205135"
                target="#72b72108-9fa7-43a9-aeed-3e3e7f8e8229"/>
          </ownedRequirements>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Folder" id="8dd60827-c4bb-4cae-9473-a255ef1ae1a9"
            ReqIFName="[REQ] Communication">
          <ownedRequirements xsi:type="Requirements:Requirement" id="d17909d5-eda4-4a78-8f81-a666dbcd2500"
              ReqIFName="COM-001" ReqIFText="&lt;p>The Lunar Lander shall provide a bidirectional communications link with the rover over a line-of-sight surface range of at least 5 km.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="e82deda2-0fe3-4682-a143-a1a5c53aba83" source="#d17909d5-eda4-4a78-8f81-a666dbcd2500"
                target="#50719bdf-3be1-40df-b1cf-afdbf3c21531"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="b1796b1c-e886-4522-aa3d-4c1db26cdbe2" source="#d17909d5-eda4-4a78-8f81-a666dbcd2500"
                target="#e5bf591e-d00c-404d-afdb-0a5ed28b11ab"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="09f672f4-c96e-4cdf-a8ea-752a7e435c7f"
              ReqIFName="COM-002" ReqIFText="&lt;p>The Lunar Lander shall store rover and lander telemetry while the Earth link is unavailable and forward stored data during subsequent communications opportunities.&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="015da761-be53-4b1f-a165-724d1ddee116" source="#09f672f4-c96e-4cdf-a8ea-752a7e435c7f"
                target="#e5bf591e-d00c-404d-afdb-0a5ed28b11ab"/>
          </ownedRequirements>
        </ownedRequirements>
      </ownedExtensions>
